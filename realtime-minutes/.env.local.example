# どのAI判定バックエンドを使うか: mock | gemini | claude | ollama
# mock はAPIキー不要のルールベース分類器(セットアップ即動作確認用)
CLASSIFIER_PROVIDER=mock

# --- Gemini (CLASSIFIER_PROVIDER=gemini のとき使用) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Claude (CLASSIFIER_PROVIDER=claude のとき使用) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Ollama (CLASSIFIER_PROVIDER=ollama のとき使用、ローカルで ollama serve 済みが前提) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
