# 未設定でもモックモードでアプリ全体は動作します
OPENAI_API_KEY=
REALTIME_MODEL=gpt-4o-realtime-preview
CHAT_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=*

# 未設定ならエラー監視は無効のまま動く(サーバーログへの出力のみ)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# データの保存先(SQLiteファイル)。空なら backend/storage/medical_ai.sqlite3
# DATABASE_PATH=

# 最後の操作からこの分数がたつと自動ログアウト
SESSION_IDLE_MINUTES=30
# 試し用の架空アカウント(demo-doctor 等)を作るか。本番では必ず false のまま
SEED_DEMO_USERS=false

# 薬剤候補の提案(AI・参考情報)。既定は無効(false)。
# 販売・配布する場合は、医療機器プログラム(薬機法)への該当性を確認してから有効にすること。
ENABLE_DRUG_SUGGESTIONS=false
