# 戦国シールドの設定ファイルのひな形
# 使い方: このファイルを .env という名前でコピーして、「=」の右側に値を書き込む。
#   cp .env.example .env
# .env は Git に入らない(鍵が GitHub に上がらない)。書き込んだら `npm run check` で接続を確かめる。

# ---- 必須: サーバーを動かす ----
# このサーバーの公開URL(Cloudflare Tunnel などで取ったURL。末尾の / は不要)
SHIELD_PUBLIC_URL=
# 見守り画面(/app)の合言葉。長くて推測されにくい文字列にする(npm run check が候補を出す)
SHIELD_APP_TOKEN=
# Twilio の Auth Token(Twilio の管理画面 → Account Info)
TWILIO_AUTH_TOKEN=

# ---- AI の返事(Claude)----
# console.anthropic.com で発行した API キー
ANTHROPIC_API_KEY=

# ---- Jev(TypeSafe)----
# TypeSafe で発行したキー。入れると、会話の流れでの詐欺判定と、相手の様子の判定に Jev を使う
TYPESAFE_API_KEY=
# 発話ごとの判定にも Jev を使うなら 1
JEV_REALTIME=1

# ---- 家族への LINE(戦国シールド専用の LINE 公式アカウント)----
# LINE Developers → Messaging API チャネル → チャネル基本設定の「チャネルシークレット」
LINE_CHANNEL_SECRET=
# Messaging API 設定の「チャネルアクセストークン(長期)」
LINE_CHANNEL_ACCESS_TOKEN=
# 友だち追加のURL(例: https://lin.ee/xxxxxxx)。見守り画面の家族登録に表示する
SHIELD_LINE_ADD_URL=

# ---- 家族への自動電話(Twilio)----
# Twilio の Account SID(AC から始まる)
TWILIO_ACCOUNT_SID=
# 発信に使う Twilio の電話番号(+81 から始まる形。例: +815012345678)
SHIELD_CALLER_ID=

# ---- 声 ----
# 本人の声が男性なら male(Twilio の自動応答と家族への電話の声)。女性なら空のまま
SHIELD_VOICE_GENDER=

# ---- 固定電話で「すべての電話にAIが先に出る」にしたとき ----
# AIを通さずにつなぐ家族・知り合いの番号(カンマ区切り、+81 から始まる形)
SHIELD_ALLOWLIST=
# その番号からの電話のつなぎ先(本人の携帯など)。実家の固定電話そのものは入れない(転送がループする)
SHIELD_FORWARD_TO=
