{
  "name": "sengoku-shield",
  "private": true,
  "description": "戦国シールド: 詐欺電話にAIが応対して時間を稼ぎ、通話内容から詐欺パターンを検知する",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "report": "node report.js",
