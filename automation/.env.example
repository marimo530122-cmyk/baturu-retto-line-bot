# --- Google Drive (source: phone uploads to a shared "議事録データ" folder) ---
# Service account JSON key contents, as a single-line JSON string.
# Share the target Drive folder with the service account's email address.
GOOGLE_SERVICE_ACCOUNT_KEY=
GDRIVE_FOLDER_ID=

# --- Gemini (extraction: summary / decisions / due-dated todos) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TypeSafe / Jev (safety-brake structural+semantic validation) ---
# Never commit a real key. Rotate immediately if one was ever pasted into
# a chat, ticket, or log.
TYPESAFE_API_KEY=
TYPESAFE_API_BASE_URL=https://api.typesafe.ai
# Endpoint path/payload shape in validate.js is UNVERIFIED (docs.typesafe.ai
# was unreachable from the build environment) - confirm against
# https://docs.typesafe.ai/api.md before relying on this in production.

# fail-closed (default): abort the pipeline if the Jev check cannot run
# (network error, bad key, etc). Set to "true" to fail-open instead.
JEV_FAIL_OPEN=false

# --- Output ---
OUTPUT_DIR=./output
