# --- Stability AI (背景/キャラクタービジュアル生成) ---
STABILITY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ElevenLabs (ホラーナレーション音声合成) ---
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 使用する声のID。ElevenLabsのVoice Libraryまたは自分で作成したボイスのIDを指定。
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# --- YouTube Data API v3 (Shorts自動投稿) ---
# Google Cloud ConsoleでOAuthクライアント(デスクトップアプリ)を作成してダウンロードしたJSON。
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# 初回認証後にトークンが保存される場所(自動生成される。手動編集不要)
YOUTUBE_TOKEN_FILE=token.json
